{
  "name": "xaihi-minecraft-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for Xaihi to interact with Minecraft via Mineflayer",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "xaihi-minecraft-mcp": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "minecraft-data": "^3.114.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.2",
    "vec3": "^0.1.8",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vec3": "^0.1.4",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
